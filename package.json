{
  "name": "@hoshinotatsuya/jest-groups",
  "version": "0.9.0",
  "description": "Run jest, vitest and pytest suites in sequential groups (at most 300 tests and 2 workers per group) with one merged report, machine protection and a no-skipped-tests check.",
  "keywords": [
    "jest",
    "vitest",
    "pytest",
    "test-runner",
    "groups",
    "sharding",
    "ci",
    "coverage",
    "workers",
    "memory"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/jest-groups.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/jest-groups#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/jest-groups/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "jest-groups": "./dist/bin/jest-groups.js",
    "vitest-groups": "./dist/bin/vitest-groups.js",
    "jest-assert-no-skipped": "./dist/bin/jest-assert-no-skipped.js",
    "jest-groups-merge": "./dist/bin/jest-groups-merge.js",
    "pytest-groups": "./dist/bin/pytest-groups.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json && node scripts/check-readme-examples.mjs",
    "lint": "biome check src",
    "test": "pnpm run build && node dist/bin/jest-groups.js --out .jest-report.json -- node_modules/.bin/jest && node dist/bin/jest-assert-no-skipped.js .jest-report.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@typescript/typescript6": ">=6.0.0 <7",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@typescript/typescript6": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.15",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "jest": "30.5.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "4.1.11"
  }
}
